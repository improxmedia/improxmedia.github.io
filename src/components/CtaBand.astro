---
const { title = 'Ready to grow your channel?', href = '/contact#book' } = Astro.props;
---
<section class="cta-band">
  <div class="wrap">
    <h2 class="reveal">{title}</h2>
    <p class="lead reveal">Tell us about your channel. We will review it and come back with three quick wins, free.</p>
    <div class="cta-row reveal" style="justify-content:center"><a class="btn btn-primary" href={href} data-magnetic>Book your free growth audit <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
  </div>
</section>
